# Токен бота, выданный @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов (сотрудников техподдержки) через запятую.
# Узнать свой ID можно у бота @userinfobot.
ADMIN_IDS=111111111,222222222

# (необязательно) ID чата/группы, куда дублировать новые заявки.
# Например, рабочий чат техподдержки. Оставьте пустым, чтобы не использовать.
SUPPORT_CHAT_ID=

# Путь к файлу базы данных SQLite
DB_PATH=./data/support.db
